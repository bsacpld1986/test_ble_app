<?xml version="1.0" encoding="utf-8"?>
<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="fill_parent"
	android:fillViewport="true">

	<LinearLayout
		android:layout_width="fill_parent"
		android:layout_height="fill_parent"
		android:orientation="vertical"
		android:gravity="left|center"
		android:background="#151515">
		
		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceLarge"
			android:text="Устройство:"
			android:layout_marginLeft="25sp"
			android:textColor="#FFFFFF"/>

		<EditText
			android:layout_height="wrap_content"
			android:layout_width="wrap_content"
			android:ems="10"
			android:layout_marginLeft="25sp"
			android:layout_marginBottom="10sp"
			android:id="@+id/FindDeviceName"
			android:width="250dp"
			android:textColor="#FFFFFF"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceLarge"
			android:text="Пароль:"
			android:layout_marginLeft="25sp"
			android:textColor="#FFFFFF"/>

		<EditText
			android:layout_height="wrap_content"
			android:layout_width="wrap_content"
			android:ems="10"
			android:layout_marginLeft="25sp"
			android:layout_marginBottom="10sp"
			android:id="@+id/FindDevicePassword"
			android:width="250dp"
			android:textColor="#FFFFFF"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceLarge"
			android:textColor="#FFFFFF"
			android:id="@+id/FindDeviceStatus"
			android:layout_marginLeft="25sp"/>

		<Button
			android:layout_height="wrap_content"
			android:text="Поиск устройства"
			android:layout_width="wrap_content"
			android:textSize="20sp"
			android:onClick="FindDeviceButton"
			android:layout_marginLeft="20dp"
			android:layout_marginTop="10dp"
			android:layout_marginBottom="25dp"
			android:textColor="#FFFFFF"
			android:id="@+id/FindDeviceButton"
			android:background="#FF8E8E8E"
			android:width="250dp"
			android:height="50dp"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceLarge"
			android:text="Запись:"
			android:layout_marginLeft="25dp"
			android:textColor="#FFFFFF"/>

		<EditText
			android:layout_height="wrap_content"
			android:layout_width="wrap_content"
			android:ems="10"
			android:layout_marginLeft="25dp"
			android:layout_marginBottom="10dp"
			android:id="@+id/WriteData"
			android:width="250dp"
			android:lines="5"
			android:gravity="top"
			android:textColor="#FFFFFFFF"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="20sp"
			android:textColor="#00FF0F"
			android:id="@+id/WriteStatus"
			android:layout_marginLeft="25dp"
			android:lines="1"/>

		<Button
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:text="Запись"
			android:layout_marginLeft="20dp"
			android:textColor="#FFFFFF"
			android:textSize="20sp"
			android:id="@+id/WriteButton"
			android:onClick="WriteButton"
			android:layout_marginBottom="25dp"
			android:background="#FF8E8E8E"
			android:height="50dp"
			android:width="120dp"
			android:layout_marginTop="10dp"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceLarge"
			android:text="Чтение:"
			android:layout_marginLeft="25dp"
			android:textColor="#FFFFFF"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textSize="20sp"
			android:textColor="#00FF0F"
			android:id="@+id/ReadData"
			android:layout_marginLeft="25dp"
			android:lines="15"
			android:textIsSelectable="true"/>
		
		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceLarge"
			android:text="Отладка:"
			android:layout_marginLeft="25sp"
			android:layout_marginTop="15sp"
			android:textColor="#FFFFFF"/>

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:textAppearance="?android:attr/textAppearanceLarge"
			android:textColor="#00FF0F"
			android:id="@+id/DebugText"
			android:layout_marginLeft="25sp"
			android:lines="5"
			android:textIsSelectable="true"
			android:layout_marginBottom="10sp"/>

	</LinearLayout>

</ScrollView>

